# =============================================================================
# BioPulse Care Backend — Contoh Konfigurasi Environment (.env.example)
# Salin file ini menjadi .env dan isi nilai sebenarnya secara lokal.
# JANGAN PERNAH melakukan commit file .env yang berisi secret asli.
# =============================================================================

# Server Binding (Gunakan 127.0.0.1 untuk pengujian lokal yang aman)
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Secret Key & API Token (Kosongkan saat dev agar dibuat ephemeral secara otomatis, wajib diisi di produksi)
JWT_SECRET_KEY=
ADMIN_API_TOKEN=

# Database (PostgreSQL untuk produksi/Docker; otomatis fallback ke SQLite lokal jika belum diisi)
# Contoh PostgreSQL: postgresql://biopulse_app:CHANGE_ME@127.0.0.1:5432/biopulse
DATABASE_URL=
SQLITE_DB_PATH=./biopulse.db

# Konfigurasi Broker MQTT (EMQX Publik untuk pengujian awal; gunakan broker privat + TLS untuk produksi)
MQTT_ENABLED=true
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=biopulse-backend
MQTT_TOPIC_PREFIX=biopulse
DEFAULT_DEVICE_ID=bp-device-001

# Interval & Ambang Batas (Dapat dikonfigurasi tanpa mengubah kode)
TELEMETRY_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=10
HEARTBEAT_TIMEOUT_SEC=30
FALL_IMPACT_THRESHOLD_MS2=22.0

# Integrasi Telegram Bot API (@BioPulseCare_bot)
# Isi TELEGRAM_BOT_TOKEN dan TELEGRAM_CHAT_ID untuk mengaktifkan pengiriman ke Telegram nyata
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_HANDLE=@BioPulseCare_bot
TELEGRAM_COOLDOWN_SEC=60
